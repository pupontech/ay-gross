---
import Card from "./Card/index.astro";
import { LINKS } from "../lib/constants";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { SITE } from "../site-config";
import ProfileAvatar from "../assets/aygross/profile.jpg";
---

<Card colSpan="md:col-span-2" rowSpan="md:row-span-4">
  <div class="grid h-full min-w-0 grid-rows-[auto_1fr] gap-4 sm:gap-5">
    <h1 class="m-0 text-center text-5xl leading-none font-bold tracking-[-0.06em] text-darkslate-50 sm:text-6xl md:text-7xl">
      Welcome
    </h1>

    <div class="flex min-w-0 flex-col justify-between gap-5 md:flex-row md:items-stretch md:gap-7">
      <div class="flex min-w-0 flex-1 flex-col justify-center gap-4 md:h-full md:justify-between">
        <div class="space-y-4">
          <p class="m-0 font-normal text-base leading-relaxed text-darkslate-100 sm:text-lg lg:text-xl">
            Hi, I'm <b class="font-bold text-darkslate-50">{SITE.author.fullName}</b>. Welcome to my little corner on the <span class="font-medium text-[var(--accent-text)]">information super<span class="sr-only">highway</span><span
              aria-hidden="true"
              class="highway-hover-trigger relative inline-grid grid-cols-1 grid-rows-1 align-baseline"
            ><span class="highway-text col-start-1 row-start-1 transition-all duration-300 ease-in-out">highway</span><span class="slopway-text col-start-1 row-start-1 opacity-0 transition-all duration-300 ease-in-out translate-y-0.5">slopway</span></span></span>.
          </p>
          <p class="m-0 max-w-2xl text-xs font-normal leading-relaxed text-darkslate-200 sm:text-sm">
            I love all things tech, photography, coffee, fishing, and dogs. I build websites, shoot photos, and work on small side projects whenever I can. If you want to collaborate on something fun, say hello.
          </p>
        </div>

        <div class="flex flex-wrap gap-2.5 pt-1 sm:gap-3">
          <a href="https://polymaths.social/@ay" target="_blank" rel="noopener noreferrer" class="inline-flex h-full max-h-[46px] w-fit items-center rounded-xl border border-primary-500/90 bg-darkslate-900 px-4 py-2 text-lg text-darkslate-50 shadow-custom shadow-primary-500 transition-all duration-150 ease-in-out hover:text-primary-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 active:translate-x-[2px] active:translate-y-[2px] active:shadow-none sm:px-5 sm:text-xl">
            <Icon name="ri:mastodon-fill" />
            <span class="sr-only">AY's Mastodon profile (opens in a new tab)</span>
          </a>
          <a href={LINKS.email} class="inline-flex h-full max-h-[46px] w-fit items-center rounded-xl border border-primary-500/90 bg-darkslate-900 px-4 py-2 text-lg text-darkslate-50 shadow-custom shadow-primary-500 transition-all duration-150 ease-in-out hover:text-primary-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 active:translate-x-[2px] active:translate-y-[2px] active:shadow-none sm:px-5 sm:text-xl">
            <Icon name="ri:mail-line" />
            <span class="sr-only">Email AY</span>
          </a>
          <a href={LINKS.wishlist} target="_blank" rel="noopener noreferrer" class="inline-flex h-full max-h-[46px] w-fit items-center rounded-xl border border-primary-500/90 bg-darkslate-900 px-4 py-2 text-lg text-darkslate-50 shadow-custom shadow-primary-500 transition-all duration-150 ease-in-out hover:text-primary-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 active:translate-x-[2px] active:translate-y-[2px] active:shadow-none sm:px-5 sm:text-xl">
            <Icon name="ri:gift-line" />
            <span class="sr-only">Wishlist (opens in a new tab)</span>
          </a>
        </div>
      </div>

      <div class="aspect-square w-full max-w-[220px] shrink-0 self-center overflow-hidden rounded-2xl border border-darkslate-400/30 shadow-lg sm:max-w-[250px] md:w-[32%] md:max-w-[280px] md:self-center md:-mt-6 lg:max-w-[300px]">
        <Image
          id="profile-avatar"
          src={ProfileAvatar}
          class="pointer-events-none h-full w-full select-none object-cover object-center"
          alt={`Portrait of ${SITE.author.firstName}`}
          layout="constrained"
          width={300}
          sizes="(max-width: 639px) 220px, (max-width: 767px) 250px, 300px"
          quality={80}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</Card>

<style>
  .highway-hover-trigger:hover .highway-text {
    opacity: 0;
    transform: translateY(-0.125rem);
  }

  .highway-hover-trigger:hover .slopway-text {
    opacity: 1;
    transform: translateY(0);
  }
</style>

