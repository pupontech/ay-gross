---
const lightThemes = [
  { id: "default", label: "Indigo", description: "light", color: "#6366f1" },
  { id: "cyan-theme", label: "Cyan", description: "light", color: "#06b6d4" },
  { id: "apricot-theme", label: "Apricot", description: "light", color: "#f97316" },
];

const darkThemes = [
  { id: "pink-theme", label: "Pink", description: "dark", color: "#ec4899" },
  { id: "purple-theme", label: "Purple", description: "dark", color: "#a855f7" },
  { id: "green-theme", label: "Green", description: "dark", color: "#10b981" },
];
---

<div class="theme-picker flex w-full flex-col gap-1.5 sm:gap-2">
  <div class="theme-group theme-group-light flex flex-col gap-1 rounded-xl p-1.5 shadow-sm">
    <div class="flex items-center justify-between px-0.5">
      <span class="theme-group-label text-[0.625rem] font-bold uppercase tracking-wider text-darkslate-100 flex items-center gap-1.5">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-amber-400"></span>
        Light
      </span>
    </div>
    <div class="theme-colors grid w-full grid-cols-3 gap-1" role="group" aria-label="Choose a light color theme">
      {lightThemes.map((theme) => (
        <button
          class="theme-option flex min-h-[2.25rem] sm:min-h-[2.5rem] flex-col items-center justify-center gap-0.5 sm:gap-1 rounded-lg border border-darkslate-400/50 bg-darkslate-600 px-1 py-1 text-darkslate-100 transition duration-150 hover:-translate-y-0.5 hover:border-primary-500 hover:bg-darkslate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-1 focus-visible:ring-offset-darkslate-500"
          data-theme={theme.id}
          aria-label={`${theme.label} ${theme.description} theme`}
          title={`${theme.label} ${theme.description} theme`}
          aria-pressed="false"
          type="button"
        >
          <span class="theme-swatch h-3.5 w-3.5 rounded-full border border-black/20 shadow-xs sm:h-4 sm:w-4" style={`--swatch: ${theme.color}`}></span>
          <span class="text-[0.625rem] font-semibold leading-none">{theme.label}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="theme-group theme-group-dark flex flex-col gap-1 rounded-xl p-1.5 shadow-sm">
    <div class="flex items-center justify-between px-0.5">
      <span class="theme-group-label text-[0.625rem] font-bold uppercase tracking-wider text-darkslate-100 flex items-center gap-1.5">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-indigo-400"></span>
        Dark
      </span>
    </div>
    <div class="theme-colors grid w-full grid-cols-3 gap-1" role="group" aria-label="Choose a dark color theme">
      {darkThemes.map((theme) => (
        <button
          class="theme-option flex min-h-[2.25rem] sm:min-h-[2.5rem] flex-col items-center justify-center gap-0.5 sm:gap-1 rounded-lg border border-darkslate-400/50 bg-darkslate-600 px-1 py-1 text-darkslate-100 transition duration-150 hover:-translate-y-0.5 hover:border-primary-500 hover:bg-darkslate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-1 focus-visible:ring-offset-darkslate-500"
          data-theme={theme.id}
          aria-label={`${theme.label} ${theme.description} theme`}
          title={`${theme.label} ${theme.description} theme`}
          aria-pressed="false"
          type="button"
        >
          <span class="theme-swatch h-3.5 w-3.5 rounded-full border border-black/20 shadow-xs sm:h-4 sm:w-4" style={`--swatch: ${theme.color}`}></span>
          <span class="text-[0.625rem] font-semibold leading-none">{theme.label}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .theme-swatch {
    background: var(--swatch);
  }

  .theme-group-light {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--darkslate-400);
  }

  .theme-group-dark {
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid var(--darkslate-400);
  }

  .theme-group-light .theme-group-label {
    background: var(--darkslate-100);
    color: var(--darkslate-700);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-weight: 700;
  }

  .theme-group-dark .theme-group-label {
    background: var(--darkslate-900);
    color: var(--darkslate-100);
    border: 1px solid var(--darkslate-400);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-weight: 700;
  }

  .theme-option[aria-pressed="true"] {
    border-color: var(--primary-600);
    background: var(--primary-100);
    color: var(--primary-900);
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--primary-300), 0 4px 10px rgb(0 0 0 / 0.18);
  }
</style>

<script>
  import { THEME_BACKGROUNDS, THEME_NAMES, ALL_THEME_CLASSES } from "../lib/theme";

  const getResolvedTheme = (): string => {
    const savedTheme = localStorage.getItem("theme");
    if (savedTheme) {
      return savedTheme;
    }
    const isDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
    return isDark ? "purple-theme" : "default";
  };

  const updateMetaThemeColor = (themeName: string) => {
    const metaThemeColor = document.querySelector('meta[name="theme-color"]');
    if (metaThemeColor) {
      metaThemeColor.setAttribute("content", THEME_BACKGROUNDS[themeName] || THEME_BACKGROUNDS.default);
    }
  };

  const updateThemeLabels = (themeName: string) => {
    const name = THEME_NAMES[themeName] || THEME_NAMES.default;
    document.querySelectorAll<HTMLElement>("[data-theme-name]").forEach((element) => {
      element.textContent = name;
    });
  };

  const syncThemeClasses = (themeName: string) => {
    ALL_THEME_CLASSES.forEach((t) => {
      document.documentElement.classList.remove(t);
      if (document.body) {
        document.body.classList.remove(t);
      }
    });
    if (themeName !== "default") {
      document.documentElement.classList.add(themeName);
      if (document.body) {
        document.body.classList.add(themeName);
      }
    }
  };

  const initThemeControls = () => {
    const themeButtons = document.querySelectorAll<HTMLButtonElement>(".theme-colors > button");

    const updateSelectedTheme = () => {
      const currentTheme = getResolvedTheme();
      themeButtons.forEach((button) => {
        const themeName = button.dataset.theme;
        const isMatch =
          themeName === currentTheme ||
          (currentTheme === "yellow-theme" && themeName === "pink-theme") ||
          (currentTheme === "blue-theme" && themeName === "cyan-theme") ||
          (currentTheme === "amber-theme" && themeName === "apricot-theme");
        button.setAttribute("aria-pressed", String(isMatch));
      });
      updateThemeLabels(currentTheme);
      updateMetaThemeColor(currentTheme);
    };

    const applyTheme = (themeName: string | undefined) => {
      const selected = themeName || "default";
      localStorage.setItem("theme", selected);
      syncThemeClasses(selected);
      updateSelectedTheme();
      document.dispatchEvent(new CustomEvent("themechange", { detail: { theme: selected } }));
    };

    updateSelectedTheme();
    themeButtons.forEach((button) => button.addEventListener("click", () => applyTheme(button.dataset.theme)));

    if (window.matchMedia) {
      const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const handleSystemThemeChange = () => {
        if (!localStorage.getItem("theme")) {
          const resolved = getResolvedTheme();
          syncThemeClasses(resolved);
          updateSelectedTheme();
        }
      };
      if (mediaQuery.addEventListener) {
        mediaQuery.addEventListener("change", handleSystemThemeChange);
      } else if ("addListener" in mediaQuery) {
        (mediaQuery as any).addListener(handleSystemThemeChange);
      }
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initThemeControls, { once: true });
  } else {
    initThemeControls();
  }
</script>
